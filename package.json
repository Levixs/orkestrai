{
  "name": "orkestrai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/orkestrai-server.mjs",
    "migrate": "npx svelar migrate",
    "migrate:agent-room-data": "node scripts/import-agent-room-sqlite.mjs",
    "migrate:rollback": "npx svelar migrate --rollback",
    "migrate:refresh": "npx svelar migrate --refresh",
    "seed": "npx svelar seed:run",
    "dev:worker": "node scripts/svelar-dev-runtime.mjs queue:work --queue=default",
    "dev:scheduler": "node scripts/svelar-dev-runtime.mjs schedule:run",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:e2e": "playwright test",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "ui:install": "npm exec --package shadcn-svelte@latest -- shadcn-svelte add --all --yes && npm install --save-prod @internationalized/date@^3.12.2 bits-ui@^2.18.1 embla-carousel-svelte@^8.6.0 formsnap@^2.0.1 layerchart@^2.0.0-next.48 mode-watcher@^1.1.0 paneforge@^1.0.2 svelte-sonner@^1.1.1 sveltekit-superforms@^2.30.1 tailwind-variants@^3.2.2 typebox@^1.1.39 vaul-svelte@^1.0.0-next.7 zod-v3-to-json-schema@^4.0.0",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.48.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/table-core": "^8.21.3",
    "@types/ws": "^8.18.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@beeblock/svelar": "^0.7.7",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@internationalized/date": "^3.12.2",
    "@types/dompurify": "^3.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.2",
    "better-sqlite3": "^12.11.1",
    "bits-ui": "^2.18.1",
    "bullmq": "^5.0.0",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "ioredis": "^5.0.0",
    "layerchart": "^2.0.4",
    "marked": "^18.0.7",
    "meilisearch": "^0.44.0",
    "mode-watcher": "^1.1.0",
    "mysql2": "^3.11.0",
    "node-pty": "^1.1.0",
    "paneforge": "^1.0.2",
    "pdfkit": "^0.18.0",
    "postgres": "^3.4.5",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.2.0",
    "typebox": "^1.3.9",
    "valibot": "^1.4.1",
    "vaul-svelte": "^1.0.0-next.7",
    "ws": "^8.21.1",
    "zod": "^3.25.0",
    "zod-v3-to-json-schema": "^4.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "main": "electron/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "build": {
    "appId": "com.orkestrai.desktop",
    "productName": "Orkestrai",
    "icon": "electron/resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "electron/**",
      "scripts/orkestrai-server.mjs",
      "src/lib/database/migrations/**",
      "src/lib/modules/agent-room/infrastructure/pty/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**",
      "**/better-sqlite3/**",
      "build/**",
      "scripts/orkestrai-server.mjs",
      "src/lib/database/migrations/**",
      "src/lib/modules/agent-room/infrastructure/pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "electron/resources/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Orkestrai"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
